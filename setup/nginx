server {
      listen 80;
      server_name foundry.joelburton.com;
      return 301 https://$host$request_uri;
  }

  server {
      listen 443 ssl;
      server_name foundry.joelburton.com;

      ssl_certificate     /etc/letsencrypt/live/foundry.joelburton.net/fullchain.pem;
      ssl_certificate_key /etc/letsencrypt/live/foundry.joelburton.net/privkey.pem;
      include             /etc/letsencrypt/options-ssl-nginx.conf;
      ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

      location / {
          proxy_pass http://localhost:3001;
          proxy_http_version 1.1;

          # WebSocket upgrade for /ws/:gameId (live game state).
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";

          proxy_set_header Host              $host;
          proxy_set_header X-Real-IP         $remote_addr;
          proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;

          proxy_read_timeout 86400s;  # keep idle WS connections alive
          proxy_buffering off;        # don't buffer WS frames
          proxy_cache off;
      }
  }
