[Unit]
Description=Freebee word game (Hono + WS)
After=network.target

[Service]
Type=simple
# Adjust User/Group/WorkingDirectory to match your server.
User=joel
Group=joel
WorkingDirectory=/opt/freebee

Environment=NODE_ENV=production
# Override if you want a different port; 3001 matches setup/nginx.
Environment=PORT=3001

# Use the absolute path to node from `which node` on the server.
ExecStart=/usr/bin/node server/server.js

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=freebee

# Hardening — safe defaults for a stateless web app.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/freebee

[Install]
WantedBy=multi-user.target
